# Copy to ~/.dbt/profiles.yml (or set DBT_PROFILES_DIR) -- never commit the real file.
# Every secret comes from an environment variable; nothing sensitive is stored here.
egypt_media_vault:
  target: dev
  outputs:
    dev:
      type: sqlserver
      driver: "ODBC Driver 18 for SQL Server"
      server: "{{ env_var('DBT_SQLSERVER_HOST') }}"            # <server>.database.windows.net
      port: 1433
      database: "{{ env_var('DBT_SQLSERVER_DATABASE', 'egypt_media_vault') }}"
      schema: "{{ env_var('DBT_SQLSERVER_SCHEMA', 'dbt') }}"    # fallback schema; models use their own (see dbt_project.yml)
      authentication: "{{ env_var('DBT_SQLSERVER_AUTH', 'sql') }}"   # sql | ActiveDirectoryPassword | ServicePrincipal | CLI | auto
      user: "{{ env_var('DBT_SQLSERVER_USER', '') }}"
      password: "{{ env_var('DBT_SQLSERVER_PASSWORD', '') }}"
      # For authentication: ServicePrincipal also add (as env vars):
      #   tenant_id: "{{ env_var('DBT_AZURE_TENANT_ID') }}"
      #   client_id: "{{ env_var('DBT_AZURE_CLIENT_ID') }}"
      #   client_secret: "{{ env_var('DBT_AZURE_CLIENT_SECRET') }}"
      encrypt: true
      trust_cert: false
      threads: 4
      retries: 3
      login_timeout: 30
      query_timeout: 600
    prod:
      type: sqlserver
      driver: "ODBC Driver 18 for SQL Server"
      server: "{{ env_var('DBT_SQLSERVER_HOST') }}"
      port: 1433
      database: "{{ env_var('DBT_SQLSERVER_DATABASE', 'egypt_media_vault') }}"
      schema: "{{ env_var('DBT_SQLSERVER_SCHEMA', 'dbt') }}"
      authentication: "{{ env_var('DBT_SQLSERVER_AUTH', 'sql') }}"
      user: "{{ env_var('DBT_SQLSERVER_USER', '') }}"
      password: "{{ env_var('DBT_SQLSERVER_PASSWORD', '') }}"
      encrypt: true
      trust_cert: false
      threads: 4
      retries: 3
      login_timeout: 30
      query_timeout: 600
