# Browser-facing base path of the API. Keep "/api/v1" to use the built-in Next.js proxy (recommended),
# or set an absolute URL such as http://localhost:8000/api/v1 (backend must then allow CORS).
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Where the Next.js server proxies /api/v1 to (server-side only).
API_PROXY_TARGET=http://localhost:8000
